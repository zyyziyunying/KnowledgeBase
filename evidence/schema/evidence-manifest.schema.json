{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zyyziyunying/KnowledgeBase/evidence/schema/evidence-manifest.schema.json",
  "title": "KnowledgeBase evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic_id",
    "topic_document",
    "verified_at",
    "claims",
    "sources"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "topic_id": { "type": "string", "minLength": 1 },
    "topic_document": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "format": "date" },
    "baseline_note": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/officialSource" },
          { "$ref": "#/$defs/officialDocument" },
          { "$ref": "#/$defs/authoritativeBlog" }
        ]
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "section", "statement", "source_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "section": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceBase": {
      "type": "object",
      "required": ["id", "source_class", "title", "publisher", "retrieved_at", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "source_class": {
          "enum": ["official_source", "official_document", "authoritative_blog"]
        },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "officialSource": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_class", "title", "publisher", "retrieved_at", "license",
            "repository_url", "revision", "path", "web_url", "raw_url",
            "raw_encoding", "sha256", "assertions"
          ],
          "properties": {
            "id": { "type": "string" },
            "source_class": { "const": "official_source" },
            "title": { "type": "string" },
            "publisher": { "type": "string" },
            "retrieved_at": { "type": "string", "format": "date" },
            "license": { "type": "string" },
            "repository_url": { "type": "string", "format": "uri" },
            "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "path": { "type": "string", "minLength": 1 },
            "web_url": { "type": "string", "format": "uri" },
            "raw_url": { "type": "string", "format": "uri" },
            "raw_encoding": { "enum": ["identity", "gitiles-base64"] },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "assertions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "officialDocument": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_class", "title", "publisher", "retrieved_at", "license",
            "url", "last_updated", "applies_to"
          ],
          "properties": {
            "id": { "type": "string" },
            "source_class": { "const": "official_document" },
            "title": { "type": "string" },
            "publisher": { "type": "string" },
            "retrieved_at": { "type": "string", "format": "date" },
            "license": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "last_updated": { "type": "string", "format": "date" },
            "applies_to": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "authoritativeBlog": {
      "allOf": [
        { "$ref": "#/$defs/sourceBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "source_class", "title", "publisher", "retrieved_at", "license",
            "url", "author", "published_at", "applies_to", "credibility_note"
          ],
          "properties": {
            "id": { "type": "string" },
            "source_class": { "const": "authoritative_blog" },
            "title": { "type": "string" },
            "publisher": { "type": "string" },
            "retrieved_at": { "type": "string", "format": "date" },
            "license": { "type": "string" },
            "url": { "type": "string", "format": "uri" },
            "author": { "type": "string", "minLength": 1 },
            "published_at": { "type": "string", "format": "date" },
            "applies_to": { "type": "string", "minLength": 1 },
            "credibility_note": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
