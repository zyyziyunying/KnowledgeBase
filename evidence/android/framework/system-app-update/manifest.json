{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "android.framework.system-app-update",
  "topic_document": "../../../../knowledge/android/framework/系统应用更新与OTA.md",
  "verified_at": "2026-08-18",
  "baseline_note": "Frameworks/base is pinned to 1cdfff555f4a21f71ccc978290e2e212e2f8b168, the same immutable revision as the Android boot and Home/SystemUI evidence packages. The Permission module, which now hosts the android.app.role framework sources, was resolved from main to immutable revision 26231a7eac744c7d2a8fea4740926620f56b20c6 on 2026-08-18. In this revision the default Home is resolved through the ROLE_HOME default app provider; the document makes no claim about any PackageManager API that persisted the default Home in older releases.",
  "claims": [
    {
      "id": "upd-001",
      "section": "更新路线与取舍",
      "statement": "When a system app is updated by a data-app install, the old system copy is moved into the disabled system package set with its code and resource paths preserved, and the new package setting is marked as an updated system app.",
      "source_ids": ["aosp-settings", "aosp-scan-package-utils", "aosp-install-package-helper"]
    },
    {
      "id": "upd-002",
      "section": "决策起点：包类别决定自由度",
      "statement": "PackageManager defines INSTALL_FAILED_UPDATE_INCOMPATIBLE as the failure code reported for an incompatible package update.",
      "source_ids": ["aosp-package-manager"]
    },
    {
      "id": "upd-003",
      "section": "更新路线与取舍",
      "statement": "PackageInstaller provides setStaged() to mark an install session as staged, and staged sessions are scheduled to be installed at the next reboot.",
      "source_ids": ["aosp-package-installer"]
    },
    {
      "id": "upd-004",
      "section": "Framework 内部链路",
      "statement": "StagingManager is the component dedicated to staged install sessions that require a reboot, and PackageManagerService applies staged packages at the end of systemReady via restoreAndApplyStagedSessionIfNeeded.",
      "source_ids": ["aosp-staging-manager", "aosp-package-manager-service"]
    },
    {
      "id": "upd-005",
      "section": "Framework 的设计支撑",
      "statement": "StagingManager registers a boot phase callback that marks staged sessions successful and completes boot handling when the system reaches PHASE_BOOT_COMPLETED.",
      "source_ids": ["aosp-staging-manager"]
    },
    {
      "id": "upd-006",
      "section": "Framework 内部链路",
      "statement": "After an update is committed the system sends ACTION_PACKAGE_REPLACED broadcasts; the decision whether to kill the replaced app is derived from the INSTALL_DONT_KILL_APP install flag, and the removal broadcast reports that decision to receivers through the EXTRA_DONT_KILL_APP extra.",
      "source_ids": ["aosp-broadcast-helper", "aosp-install-package-helper"]
    },
    {
      "id": "upd-007",
      "section": "Framework 内部链路",
      "statement": "While an update is installed, the package being replaced is frozen through PackageFreezer with ApplicationExitInfo.REASON_PACKAGE_UPDATED.",
      "source_ids": ["aosp-install-package-helper"]
    },
    {
      "id": "upd-008",
      "section": "Framework 内部链路",
      "statement": "The default Home activity is resolved by ComputerEngine through getDefaultHomeActivity and getHomeActivitiesAsUser, consulting the ROLE_HOME default app provider and falling back to the preferred activity during the role transition window.",
      "source_ids": ["aosp-computer-engine", "aosp-role-manager"]
    },
    {
      "id": "upd-009",
      "section": "Framework 的设计支撑",
      "statement": "Privileged permission allowlists for privileged apps are read by SystemConfig from privapp-permissions XML files in the system image.",
      "source_ids": ["aosp-system-config"]
    }
  ],
