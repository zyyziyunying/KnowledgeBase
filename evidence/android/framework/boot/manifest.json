{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "android.framework.boot",
  "topic_document": "../../../../knowledge/android/framework/Android-Framework-高频核心讲义.md",
  "verified_at": "2026-08-17",
  "baseline_note": "AOSP main was resolved to immutable revisions on 2026-08-14; WindowManagerService was added from the same frameworks/base revision and the complete package was reverified on 2026-08-17. Official web documents remain dynamic and therefore record update and retrieval dates instead of content hashes.",
  "claims": [
    {
      "id": "boot-001",
      "section": "Bootloader 与 Kernel 的边界",
      "statement": "Bootloader verifies the selected boot path and loads the kernel, ramdisk, device configuration, and related boot images before transferring control to the kernel.",
      "source_ids": ["android-bootloader-doc"]
    },
    {
      "id": "boot-002",
      "section": "init 不是一个阶段，而是三段启动",
      "statement": "Modern AOSP early init is divided into first-stage init, SELinux setup, and second-stage init.",
      "source_ids": ["aosp-init-readme"]
    },
    {
      "id": "boot-003",
      "section": "init 不是一个阶段，而是三段启动",
      "statement": "Second-stage init advances through event and property triggers, including zygote-start before early-boot and boot.",
      "source_ids": ["aosp-init-readme"]
    },
    {
      "id": "boot-004",
      "section": "init 怎样启动 Zygote",
      "statement": "The 64-bit primary Zygote service starts app_process64 with --zygote and --start-system-server.",
      "source_ids": ["aosp-init-zygote64-rc"]
    },
    {
      "id": "boot-005",
      "section": "init 怎样启动 Zygote",
      "statement": "app_process enters com.android.internal.os.ZygoteInit through AndroidRuntime.",
      "source_ids": ["aosp-app-main"]
    },
    {
      "id": "boot-006",
      "section": "init 怎样启动 Zygote",
      "statement": "Zygote preloads shared runtime state, forks system_server when requested, and then accepts process creation commands; some products can use USAPs or multiple Zygotes.",
      "source_ids": ["aosp-zygote-init", "android-zygote-doc"]
    },
    {
      "id": "boot-007",
      "section": "system_server 怎样启动 Framework 服务",
      "statement": "Current SystemServer starts bootstrap, core, other, and APEX system-service groups.",
      "source_ids": ["aosp-system-server"]
    },
    {
      "id": "boot-008",
      "section": "system_server 怎样启动 Framework 服务",
      "statement": "SystemServiceManager delivers monotonically increasing boot phases to started SystemService instances through onBootPhase.",
      "source_ids": ["aosp-system-service-manager"]
    },
    {
      "id": "boot-009",
      "section": "从 systemReady 到用户可操作",
      "statement": "Home activities are started per user and display after the activity/window system reaches the appropriate readiness state.",
      "source_ids": ["aosp-root-window-container"]
    },
    {
      "id": "boot-010",
      "section": "从 systemReady 到用户可操作",
      "statement": "PHASE_BOOT_COMPLETED and sys.boot_completed are global Framework milestones, while LOCKED_BOOT_COMPLETED and BOOT_COMPLETED are delivered through per-user lifecycle handling.",
      "source_ids": ["aosp-activity-manager", "aosp-user-controller"]
    },
    {
      "id": "boot-011",
      "section": "Zygote 为什么能加快应用启动",
      "statement": "Zygote preloaded classes reduce repeated app initialization and enable memory sharing, but the preload list must be tuned to avoid wasted memory.",
      "source_ids": ["android-art-config-doc"]
    },
    {
      "id": "boot-012",
      "section": "从 systemReady 到用户可操作",
      "statement": "WindowManager waits for required boot windows, stops the boot animation, notifies SurfaceControl that boot finished, enables the display, and enables input dispatch through a screen-enabling path separate from Framework boot-completion markers.",
      "source_ids": ["aosp-window-manager-service"]
    }
  ],
