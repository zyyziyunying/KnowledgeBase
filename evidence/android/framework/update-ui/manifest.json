{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "android.framework.update-ui",
  "topic_document": "../../../../knowledge/android/framework/系统更新UI与Home无缝切换.md",
  "verified_at": "2026-08-18",
  "baseline_note": "Frameworks/base is pinned to 1cdfff555f4a21f71ccc978290e2e212e2f8b168, the same immutable revision as the Android boot, Home/SystemUI, and system-app-update evidence packages. The recovery repository was resolved from main to immutable revision 9565b5ee790a4ae7acd0c6c04a2b3e0c7eeced3c on 2026-08-18. The install-side mechanisms (staged commit at systemReady, package freeze and kill) are covered by the sibling system-app-update evidence package and are not duplicated here; the sibling package asserts the disable side of the disabled-system-copy mechanism, while this package asserts the enable/revert side used by uninstall. Google's closed-source update screen is recorded as an industry observation in the document, not as an evidence source.",
  "claims": [
    {
      "id": "upd-ui-001",
      "section": "开机动画何时退场（核心机制）",
      "statement": "The boot animation does not exit on its own: BootAnimation polls the service.bootanim.exit property and requests exit when it is set, and WindowManagerService sets that property during screen enable together with SurfaceControl.bootFinished() and the ActivityManager bootAnimationComplete() notification.",
      "source_ids": ["aosp-bootanimation", "aosp-bootanim-rc", "aosp-wms", "aosp-surface-control"]
    },
    {
      "id": "upd-ui-002",
      "section": "开机动画何时退场（核心机制）",
      "statement": "ActivityManager marks the boot animation complete in bootAnimationComplete and, when boot completes, ensureBootCompleted enables the screen through ActivityTaskManagerInternal.enableScreenAfterBoot.",
      "source_ids": ["aosp-ams"]
    },
    {
      "id": "upd-ui-003",
      "section": "Framework 的防闪机制：ThemeHomeDelay",
      "statement": "ActivityManagerService can delay the Home launch until ThemeOverlayController reports readiness (ThemeHomeDelay), with a 15000 ms HOME_LAUNCH_TIMEOUT_MS fallback.",
      "source_ids": ["aosp-ams"]
    },
    {
      "id": "upd-ui-004",
      "section": "Windows 式更新屏的 Android 对应物",
      "statement": "Recovery's ScreenRecoveryUI selects the localized installing_text or installing_security_text bitmap to display while a system update is being installed.",
      "source_ids": ["aosp-screen-ui"]
    },
    {
      "id": "upd-ui-005",
      "section": "兜底与回滚",
      "statement": "The pm uninstall command removes a data-app update of a system app, and the package delete path reinstates the disabled system copy through Settings.enableSystemPackageLPw, restoring the previous system version.",
      "source_ids": ["aosp-pm-shell", "aosp-install-helper-enable", "aosp-settings-enable"]
    }
  ],
