{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "android.framework.update-ui",
  "topic_document": "../../../../knowledge/android/framework/系统更新UI与Home无缝切换.md",
  "verified_at": "2026-08-20",
  "baseline_note": "Frameworks/base is pinned to 1cdfff555f4a21f71ccc978290e2e212e2f8b168, the same immutable revision as the Android boot, Home/SystemUI, and system-app-update evidence packages. The recovery repository was resolved from main to immutable revision 9565b5ee790a4ae7acd0c6c04a2b3e0c7eeced3c on 2026-08-18. The install-side mechanisms are owned by the sibling system-app-update evidence package, which now keeps A/B OTA slot updates distinct from PackageInstaller staged sessions. This package additionally pins the platform permission declarations, PackageInstallerSession update-permission check, and system-developer permission model used to bound the candidate UpdateCoordinator and TransitionRenderer architecture; the architecture and device behavior remain proposals, not AOSP-provided or device-verified facts. Recovery minui is evidence only for paths that actually enter recovery, not for the normal A/B reboot path. The sibling package asserts the disable side of the disabled-system-copy mechanism, while this package asserts the enable/revert side used by uninstall. Google's closed-source update screen is recorded as an industry observation in the document, not as an evidence source.",
  "claims": [
    {
      "id": "upd-ui-001",
      "section": "开机动画何时退场（核心机制）",
      "statement": "The boot animation does not exit on its own: BootAnimation polls the service.bootanim.exit property and requests exit when it is set, and WindowManagerService sets that property during screen enable together with SurfaceControl.bootFinished() and the ActivityManager bootAnimationComplete() notification.",
      "source_ids": ["aosp-bootanimation", "aosp-bootanim-rc", "aosp-wms", "aosp-surface-control"]
    },
    {
      "id": "upd-ui-002",
      "section": "开机动画何时退场（核心机制）",
      "statement": "ActivityManager marks the boot animation complete in bootAnimationComplete and, when boot completes, ensureBootCompleted enables the screen through ActivityTaskManagerInternal.enableScreenAfterBoot.",
      "source_ids": ["aosp-ams"]
    },
    {
      "id": "upd-ui-003",
      "section": "Framework 的防闪机制：ThemeHomeDelay",
      "statement": "ActivityManagerService can delay the Home launch until ThemeOverlayController reports readiness (ThemeHomeDelay), with a 15000 ms HOME_LAUNCH_TIMEOUT_MS fallback.",
      "source_ids": ["aosp-ams"]
    },
    {
      "id": "upd-ui-004",
      "section": "Windows 式更新屏的 Android 对应物",
      "statement": "When an update path actually enters recovery, Recovery's ScreenRecoveryUI selects the localized installing_text or installing_security_text bitmap; this claim does not describe the normal A/B OTA reboot path.",
      "source_ids": ["aosp-screen-ui"]
    },
    {
      "id": "upd-ui-005",
      "section": "兜底与回滚",
      "statement": "The pm uninstall command removes a data-app update of a system app, and the package delete path reinstates the disabled system copy through Settings.enableSystemPackageLPw, restoring the previous system version.",
      "source_ids": ["aosp-pm-shell", "aosp-install-helper-enable", "aosp-settings-enable"]
    },
    {
      "id": "upd-ui-006",
      "section": "开机动画何时退场（核心机制）",
      "statement": "WindowManagerService normally waits for required system-decor windows and boot-animation completion before enabling the display, but enableScreenAfterBoot schedules a nominal 30-second boot timeout scaled by Build.HW_TIMEOUT_MULTIPLIER whose handler forces display enablement, so the source establishes a normal anti-flash path and a failure fallback rather than an absolute no-black-frame guarantee.",
      "source_ids": ["aosp-wms"]
    },
    {
      "id": "upd-ui-007",
      "section": "候选架构：最小权限的运行态交接",
      "statement": "At the pinned AOSP revision, INSTALL_PACKAGES, INSTALL_PACKAGE_UPDATES, and MANAGE_ROLLBACKS are signature|privileged permissions, while MANAGE_ROLE_HOLDERS is signature|installer|module; PackageInstallerSession counts INSTALL_PACKAGE_UPDATES toward its install-permission decision only when the target is an update of an existing package.",
      "source_ids": ["aosp-platform-permission-declarations", "aosp-package-installer-session"]
    },
    {
      "id": "upd-ui-008",
      "section": "权限高度与最小化边界",
      "statement": "At the pinned AOSP revision, INTERNAL_SYSTEM_WINDOW is signature|module|recents, while FREEZE_SCREEN, INJECT_EVENTS, and FILTER_EVENTS are signature permissions; privileged-app status alone therefore does not satisfy these signature-only or non-privileged system-window and input permissions.",
      "source_ids": ["aosp-platform-permission-declarations", "aosp-system-developer-permissions"]
    },
    {
      "id": "upd-ui-009",
      "section": "权限高度与最小化边界",
      "statement": "AOSP's system-developer permission model defines a platform signature permission as requiring the platform signing certificate, and defines combined protection flags as an OR relationship, so signature|privileged can be satisfied either by platform signing or qualified privileged-app status.",
      "source_ids": ["aosp-system-developer-permissions"]
    }
  ],
