{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "android.framework.home-system-ui",
  "topic_document": "../../../../knowledge/android/framework/Home-Launcher-SystemUI-进程与APK边界.md",
  "verified_at": "2026-08-17",
  "baseline_note": "Launcher3 main was resolved to an immutable revision on 2026-08-17. Frameworks/base uses the same immutable revision as the Android boot evidence package and was reverified for Home and SystemUI claims on 2026-08-17.",
  "claims": [
    {
      "id": "home-ui-001",
      "section": "Home：一个角色，不是写死的类名",
      "statement": "AOSP Launcher3 is built as a privileged android_app package, and its Launcher Activity advertises MAIN, HOME, and DEFAULT intent categories.",
      "source_ids": ["aosp-launcher3-build", "aosp-launcher3-manifest"]
    },
    {
      "id": "home-ui-002",
      "section": "Framework 怎样启动 Home",
      "statement": "The Framework resolves a Home intent for a user and display area, converts the resolved ActivityInfo into an explicit component, and starts that Home Activity; it also has separate handling for secondary displays.",
      "source_ids": ["aosp-root-window-container"]
    },
    {
      "id": "home-ui-003",
      "section": "SystemUI：独立 APK，也是特权持久进程",
      "statement": "AOSP SystemUI is built as a privileged platform android_app with package com.android.systemui, a persistent application process, and a declared SystemUIService.",
      "source_ids": ["aosp-systemui-build", "aosp-systemui-manifest"]
    },
    {
      "id": "home-ui-004",
      "section": "SystemUI：独立 APK，也是特权持久进程",
      "statement": "AOSP defines SystemUI as a persistent process that provides system UI outside the system_server process.",
      "source_ids": ["aosp-systemui-readme"]
    },
    {
      "id": "home-ui-005",
      "section": "谁启动 SystemUI",
      "statement": "SystemServer obtains the configured SystemUI service component, starts it as the system user, and then notifies WindowManager that SystemUI started.",
      "source_ids": ["aosp-system-server"]
    },
    {
      "id": "home-ui-006",
      "section": "谁启动 SystemUI",
      "statement": "Home Activity resolution and SystemUI service startup are separate Framework paths and target separate application components.",
      "source_ids": ["aosp-root-window-container", "aosp-system-server"]
    }
  ],
