{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "flutter.engine.android-input-to-route-first-frame",
  "topic_document": "../../../../knowledge/flutter/engine/Android-输入到路由首帧.md",
  "verified_at": "2026-09-04",
  "baseline_note": "Flutter Framework main and Flutter Engine main were independently resolved to immutable revisions on 2026-09-04. They are source-reading baselines for the documented call chain, not a claim that a particular Flutter SDK ships this exact Framework/Engine pairing. Android documents remain dynamic and therefore record their published update and retrieval dates instead of content hashes.",
  "claims": [
    {
      "id": "flutter-android-nav-001",
      "section": "Android MotionEvent 到 Dart 指针包",
      "statement": "On Android, FlutterView forwards touch MotionEvents through AndroidTouchProcessor, FlutterRenderer, FlutterJNI, JNI and PlatformView; Shell transfers the packet to the UI task runner, where Engine dispatches it to the runtime controller.",
      "source_ids": [
        "engine-flutter-view",
        "engine-android-touch-processor",
        "engine-flutter-renderer",
        "engine-flutter-jni",
        "engine-platform-view-android-jni",
        "engine-platform-view",
        "engine-shell",
        "engine-core"
      ]
    },
    {
      "id": "flutter-android-nav-002",
      "section": "一次交互的跨层链路",
      "statement": "In the AOSP input architecture, EventHub reads kernel evdev events, InputReader decodes them into Android input events, and InputDispatcher forwards them to the appropriate window.",
      "source_ids": ["android-input-doc"]
    },
    {
      "id": "flutter-android-nav-003",
      "section": "指针包到 onTap",
      "statement": "GestureBinding receives pointer data packets through PlatformDispatcher and expands them into logical PointerEvents before hit-testing pointer down events; it sweeps the gesture arena on pointer up. TapGestureRecognizer's onTapDown occurs only after its short deadline or after it wins the arena, while a successful recognizer invokes onTap after onTapUp while processing the up event.",
      "source_ids": ["framework-gestures-binding", "framework-gestures-tap"]
    },
    {
      "id": "flutter-android-nav-004",
      "section": "指针包到 onTap",
      "statement": "The pinned Framework baseline declares touch resampling disabled by default and documents that enabling it trades some added latency for smoother touch-event processing.",
      "source_ids": ["framework-gestures-binding"]
    },
    {
      "id": "flutter-android-nav-005",
      "section": "onTap 到 Route 状态",
      "statement": "NavigatorState.push adds a route entry and flushes history updates; route installation precedes didPush, and TransitionRoute creates its animation controller during install and drives it forward from didPush.",
      "source_ids": ["framework-navigator", "framework-routes"]
    },
    {
      "id": "flutter-android-nav-006",
      "section": "Route 状态到 Scene",
      "statement": "SchedulerBinding schedules a PlatformDispatcher frame that is serviced from VSync; WidgetsBinding builds dirty elements, while RendererBinding flushes layout/compositing/paint and sends RenderView composite frames to the engine.",
      "source_ids": [
        "framework-scheduler-binding",
        "framework-widgets-binding",
        "framework-rendering-binding"
      ]
    },
    {
      "id": "flutter-android-nav-008",
      "section": "Scene 到屏幕",
      "statement": "Android graphics surfaces are BufferQueue producers commonly consumed by SurfaceFlinger, which composites visible surfaces and uses Hardware Composer for display work; this lies beyond Flutter's build and raster timing endpoints.",
      "source_ids": ["android-graphics-doc", "engine-platform-dispatcher"]
    },
    {
      "id": "flutter-android-nav-009",
      "section": "诊断：先设置端点，再谈优化",
      "statement": "FrameTiming exposes vsync, UI build and raster phase timestamps, including a wall-time raster-finish timestamp for system-trace correlation; the Framework-recommended SchedulerBinding callback permits multiple timing observers.",
      "source_ids": ["engine-platform-dispatcher"]
    },
    {
      "id": "flutter-android-nav-010",
      "section": "诊断：先设置端点，再谈优化",
      "statement": "Flutter's Performance view reports UI and raster frame work and should be used with profile builds because debug frame timing is not representative of profile or release behavior.",
      "source_ids": ["flutter-devtools-performance-doc", "flutter-performance-profiling-doc"]
    },
    {
      "id": "flutter-android-nav-011",
      "section": "常见错误归因",
      "statement": "Flutter UI work is coupled to the main isolate, while helper isolates communicate through messages; moving work to an isolate is applicable to suitably separable computation rather than a replacement for UI-thread diagnosis.",
      "source_ids": ["flutter-isolates-doc"]
    }
  ],
