{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "flutter.engine.thread-model-and-performance-synchronization",
  "topic_document": "../../../../knowledge/flutter/engine/线程模型与性能同步.md",
  "verified_at": "2026-09-04",
  "baseline_note": "Flutter Engine main was resolved to immutable revision ae5c3603d013477d37ae301993fc0967d4ad7ed2 on 2026-09-04. This is a source-reading and evidence-validation baseline, not a claim that an arbitrary Flutter SDK, Android embedding, device, or application uses this exact runtime topology. The Flutter documentation pages are dynamic, so their publication and retrieval metadata are recorded instead of content hashes.",
  "claims": [
    {
      "id": "flutter-thread-sync-001",
      "section": "四个概念，不能互换",
      "statement": "TaskRunners holds separate platform, raster, UI, and IO TaskRunner references. The Android implementation may deliberately assign the same TaskRunner object to more than one role, so role names do not by themselves establish a count of native threads.",
      "source_ids": [
        "engine-task-runners",
        "engine-android-shell-holder"
      ]
    },
    {
      "id": "flutter-thread-sync-002",
      "section": "默认拓扑：platform 与 UI 静态合并",
      "statement": "The pinned Engine Settings default merged_platform_ui_thread to true. AndroidShellHolder uses the current MessageLoop TaskRunner for platform work, always creates raster and IO thread-host members, and assigns the UI runner to the platform runner when that setting is true; it creates a UI thread only when the setting is false.",
      "source_ids": [
        "engine-settings",
        "engine-android-shell-holder"
      ]
    },
    {
      "id": "flutter-thread-sync-003",
      "section": "Dart UI root isolate 在哪里运行",
      "statement": "DartIsolate assigns a non-platform isolate's message-handling task runner to the UI TaskRunner. The same source explicitly compares platform and UI task runners when assigning Dart VM Service labels, labelling the platform runner as UI when they are equal, while documenting that this does not change the underlying OS thread names; therefore a UI label alone is not proof of distinct platform and UI runners.",
      "source_ids": [
        "engine-dart-isolate",
        "flutter-isolates-doc"
      ]
    },
    {
      "id": "flutter-thread-sync-004",
      "section": "同一 runner 时，输入派发怎样执行",
      "statement": "Shell's pointer handler runs on the platform TaskRunner and invokes RunNowAndFlushMessages on the UI TaskRunner. RunNowAndFlushMessages executes the task immediately when its runner is current, then posts an empty task for message-loop observers; otherwise it posts the task to the target runner.",
      "source_ids": [
        "engine-shell",
        "engine-fml-task-runner"
      ]
    },
    {
      "id": "flutter-thread-sync-005",
      "section": "VSync 与 UI→raster：这不是同一类等待",
      "statement": "Animator posts AwaitVSync work to the UI TaskRunner. When it cannot obtain a FramePipeline producer continuation, it records PipelineFull because the consumer is too slow; once a pipeline is ready, Shell posts its draw work to the raster TaskRunner.",
      "source_ids": [
        "engine-animator",
        "engine-shell"
      ]
    },
    {
      "id": "flutter-thread-sync-006",
      "section": "另一种合并：Platform View 的动态 raster/platform merger",
      "statement": "Rasterizer creates a RasterThreadMerger only when an external view embedder supports dynamic thread merging. AndroidExternalViewEmbedder reports that support, but its PostPrerollAction returns without merging when a frame has no platform layers; otherwise it requests a merge lease and returns a skip-and-retry result for the transition.",
      "source_ids": [
        "engine-raster-thread-merger",
        "engine-rasterizer",
        "engine-android-external-view-embedder"
      ]
    },
    {
      "id": "flutter-thread-sync-007",
      "section": "诊断协议：先同步拓扑，再看耗时",
      "statement": "Flutter's documentation describes the UI role of the main isolate and message-based helper-isolate communication. Its Performance view documentation presents UI and raster frame information, while the profiling guidance recommends profile mode for representative performance measurement.",
      "source_ids": [
        "flutter-isolates-doc",
        "flutter-devtools-performance-doc",
        "flutter-performance-profiling-doc"
      ]
    }
  ],
