{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "flutter.engine.runtime-performance-validation",
  "topic_document": "../../../../knowledge/flutter/engine/运行时性能验证链.md",
  "verified_at": "2026-09-10",
  "baseline_note": "Flutter tool source is pinned to the Flutter 3.44.1 Framework revision used to verify the --trace-systrace launch path. Dart Timeline is pinned to the Dart 3.12.1 tag. Perfetto documentation sources are pinned to an immutable official repository revision. These sources define a reusable capture protocol, not a claim about any application's device trace or measured latency. Clock synchronization and FrameTimeline sources were added on 2026-09-10 at the same pinned Perfetto revision; original source verification dates are preserved. The SQL templates are protocol examples, not device-trace validation.",
  "claims": [
    {
      "id": "flutter-runtime-validation-001",
      "section": "采集：必须启用应用级 ATrace",
      "statement": "The Flutter run command exposes trace-systrace, and the Android device launch path passes a trace-systrace=true boolean extra when that debugging option is enabled.",
      "source_ids": [
        "flutter-tool-run-command",
        "flutter-tool-android-device"
      ]
    },
    {
      "id": "flutter-runtime-validation-002",
      "section": "给应用加入可查询的业务端点",
      "statement": "Dart Timeline.startSync defines a synchronous operation that must finish before returning to the event queue, while Timeline.timeSync brackets its function with startSync and finishSync.",
      "source_ids": [
        "dart-timeline"
      ]
    },
    {
      "id": "flutter-runtime-validation-003",
      "section": "采集：必须启用应用级 ATrace",
      "statement": "Perfetto's ftrace configuration selects Android system categories through atrace_categories and app events through atrace_apps, and the lightweight perfetto CLI exposes -a/--app to select an Android app for app-level atrace tracing.",
      "source_ids": [
        "perfetto-atrace",
        "perfetto-cli"
      ]
    },
    {
      "id": "flutter-runtime-validation-004",
      "section": "查询：固定一次操作和有限窗口",
      "statement": "Perfetto Trace Processor ingests traces into queryable tables, and its query subcommand loads a trace and runs one or more SQL statements.",
      "source_ids": [
        "perfetto-trace-processor"
      ]
    },
    {
      "id": "flutter-runtime-validation-005",
      "section": "最小闭环：端点必须分层",
      "statement": "FrameTiming exposes build and raster timing endpoints and recommends SchedulerBinding.addTimingsCallback for Framework users; Flutter profiling guidance distinguishes debug from profile/release measurement, while Android's graphics architecture has separate BufferQueue, SurfaceFlinger, and Hardware Composer stages. Therefore raster timing and eventual UI-state checks do not alone establish a display-present timestamp.",
      "source_ids": [
        "engine-platform-dispatcher",
        "flutter-performance-profiling-doc",
        "android-graphics-doc"
      ]
    },
    {
      "id": "flutter-runtime-validation-006",
      "section": "时钟对齐与缺失证据",
      "statement": "Trace Processor uses clock snapshots to synchronize known clock domains onto a global trace timeline; independently recorded wall-clock timestamps require an established clock mapping before comparison with trace timestamps.",
      "source_ids": [
        "perfetto-clock-sync",
        "engine-platform-dispatcher"
      ]
    },
    {
      "id": "flutter-runtime-validation-007",
      "section": "关联：从目标页面到系统呈现",
      "statement": "The pinned FrameTimeline documentation requires Android 12 or higher and explicitly excludes SurfaceView support. It exposes actual/expected frame tables with surface/display tokens and layer names, relates app frames to SurfaceFlinger DisplayFrames, and distinguishes app completion from display presentation and dropped frames.",
      "source_ids": [
        "perfetto-frametimeline"
      ]
    }
  ],
