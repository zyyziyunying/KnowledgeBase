{
  "$schema": "../../../schema/evidence-manifest.schema.json",
  "schema_version": 1,
  "topic_id": "flutter.rendering.android-platform-views",
  "topic_document": "../../../../knowledge/flutter/rendering/Android-Platform-Views与原生渲染.md",
  "verified_at": "2026-10-03",
  "baseline_note": "Flutter release tag 3.44.0 was resolved through the official repository commit API to 559ffa3f75e7402d65a8def9c28389a9b2e6fe42 on 2026-10-03. Framework and Engine source hashes use that immutable monorepo revision. Dynamic official documents retain their own update and retrieval dates; no web-page snapshots are vendored. These are source-reading assertions, not device benchmarks, proof of a particular plugin backend, or claims about the latest SDK. Engineering selection advice in the document is labeled separately.",
  "claims": [
    {
      "id": "flutter-platform-views-001",
      "section": "术语与集成方案",
      "statement": "The pinned implementation distinguishes VD, texture-layer composition, HC and HCPP; a backend Texture is a separate image integration contract from hosting an interactive platform View.",
      "source_ids": [
        "hcpp-controller",
        "framework-widgets",
        "framework-texture"
      ]
    },
    {
      "id": "flutter-platform-views-002",
      "section": "TLHC 重定向 View 的绘制",
      "statement": "TLHC attaches a wrapper to FlutterView and redirects child drawing to a render-target hardware Canvas; the controller selects among SurfaceProducer, ImageReader and SurfaceTexture targets.",
      "source_ids": [
        "view-wrapper",
        "legacy-controller"
      ]
    },
    {
      "id": "flutter-platform-views-003",
      "section": "SurfaceView 与回退",
      "statement": "The legacy controller checks the View subtree for SurfaceView during creation and chooses requested HC fallback or non-software VD fallback when TLHC is unsupported.",
      "source_ids": [
        "legacy-controller",
        "framework-services",
        "android-platform-views-doc"
      ]
    },
    {
      "id": "flutter-platform-views-004",
      "section": "VD 通过虚拟显示获得纹理",
      "statement": "VD connects a render-target Surface to a VirtualDisplay and hosts the View through SingleViewPresentation; resize behavior has an Android API 31 branch.",
      "source_ids": [
        "virtual-display",
        "legacy-controller"
      ]
    },
    {
      "id": "flutter-platform-views-005",
      "section": "HC 将 Flutter 输出加入 Android View 层级",
      "statement": "Legacy HC can convert FlutterView to an ImageReader-backed FlutterImageView and supply overlay views for Flutter content above platform Views.",
      "source_ids": [
        "legacy-controller",
        "flutter-view",
        "flutter-image-view",
        "legacy-embedder"
      ]
    },
    {
      "id": "flutter-platform-views-006",
      "section": "线程与叠加限制",
      "statement": "Legacy AndroidExternalViewEmbedder supports conditional raster/platform merging; HCPP AndroidExternalViewEmbedder2 explicitly does not, while still posting platform tasks and containing initialization/teardown waits.",
      "source_ids": [
        "legacy-embedder",
        "hcpp-embedder"
      ]
    },
    {
      "id": "flutter-platform-views-007",
      "section": "HardwareBuffer 与图层事务",
      "statement": "The Vulkan swapchain selection tries opted-in AHB presentation when supported. AHB buffers are presented through SurfaceControl with readiness and release synchronization, and Android supplies a JNI transaction callback.",
      "source_ids": [
        "vk-swapchain",
        "ahb-swapchain",
        "ahb-swapchain-impl",
        "android-vulkan"
      ]
    },
    {
      "id": "flutter-platform-views-008",
      "section": "HardwareBuffer 与图层事务",
      "statement": "HCPP keeps real Views in FlutterView and merges active transactions at onEndFrame, invalidating the View and applying transactions on draw. Android distinguishes atomic ViewRoot submission from buffer readiness and safe reuse.",
      "source_ids": [
        "hcpp-controller",
        "attached-surface-control-doc",
        "surface-transaction-doc"
      ]
    },
    {
      "id": "flutter-platform-views-009",
      "section": "线程与叠加限制",
      "statement": "The pinned HCPP embedder uses a single overlay and difference clipping; direct SurfaceView clipping uses path bounds. Arbitrary transparent interleaving and path-accurate clipping are not implied by SurfaceView support.",
      "source_ids": [
        "hcpp-embedder",
        "hcpp-controller",
        "android-platform-views-doc"
      ]
    },
    {
      "id": "flutter-platform-views-010",
      "section": "创建 API 与 HCPP 配置",
      "statement": "Legacy Dart factories request TLHC with VD or HC fallback, or HC directly. PlatformViewsChannel gives enabled HCPP precedence. Official configuration requires API 34 and Impeller Vulkan; applyTransactionOnDraw itself dates to API 31.",
      "source_ids": [
        "framework-services",
        "framework-widgets",
        "platform-views-channel",
        "hcpp-controller",
        "android-platform-views-doc",
        "attached-surface-control-doc"
      ]
    },
    {
      "id": "flutter-platform-views-011",
      "section": "创建与交互的共同链路",
      "statement": "Platform-view creation uses a registered viewType and controller. AndroidView participates in Flutter gesture arenas, and native wrappers apply mutators and intercept touch for Flutter coordination.",
      "source_ids": [
        "framework-services",
        "framework-widgets",
        "legacy-controller",
        "mutator-view"
      ]
    },
    {
      "id": "flutter-platform-views-012",
      "section": "外部 Texture 与 SurfaceProducer",
      "statement": "Texture repaint can be driven by backend frames without Dart execution. SurfaceProducer exposes a Surface, physical size, availability/cleanup callbacks, release and crop/rotation responsibilities.",
      "source_ids": [
        "framework-texture",
        "native-texture-registry",
        "surface-plugins-doc"
      ]
    },
    {
      "id": "flutter-platform-views-013",
      "section": "iOS 与其他平台边界",
      "statement": "The iOS guide describes UIKit hierarchy-based hybrid composition and documents ShaderMask, ColorFiltered and BackdropFilter limitations; Android composition modes are not an iOS implementation taxonomy.",
      "source_ids": [
        "ios-platform-views-doc"
      ]
    }
  ],
